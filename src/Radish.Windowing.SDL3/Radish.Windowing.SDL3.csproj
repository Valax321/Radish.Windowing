<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>Radish.Windowing.SDL3</PackageId>
        <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Title>Radish Windowing - SDL3 Backend</Title>
        <Description>SDL3 backend for Radish.Windowing</Description>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <DocumentationFile>bin\Debug\Radish.Windowing.SDL3.xml</DocumentationFile>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <DocumentationFile>bin\Release\Radish.Windowing.SDL3.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
      <Compile Include="..\Thirdparty\SDL3-CS\SDL3\SDL3.Core.cs" Link="SDL3.Core.cs" />
    </ItemGroup>

    <ItemGroup>
      <None Include="..\Thirdparty\SDL3-prebuilt\win-x64\SDL3.dll" Link="runtimes/win-x64/native/SDL3.dll" Pack="true" PackagePath="runtimes/win-x64/native/">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Include="..\Thirdparty\SDL3-prebuilt\win-arm64\SDL3.dll" Link="runtimes/win-arm64/native/SDL3.dll" Pack="true" PackagePath="runtimes/win-arm64/native/">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Include="..\Thirdparty\SDL3-prebuilt\win-x86\SDL3.dll" Link="runtimes/win-x86/native/SDL3.dll" Pack="true" PackagePath="runtimes/win-x86/native/">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Radish.Windowing\Radish.Windowing.csproj" />
    </ItemGroup>

</Project>
